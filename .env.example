# Ma'lumotlar bazasi (SQLite) — nisbiy yo'l, prisma/schema.prisma'ga nisbatan
DATABASE_URL="file:../db/custom.db"

# Qidiruv dvigateli (ixtiyoriy):
#   auto (standart) — Z.ai SDK bor bo'lsa u ishlaydi, bo'lmasa DuckDuckGo/Bing
#   open — faqat ochiq dvigatellar (DuckDuckGo → Bing), lokal mashina uchun
#   zai — faqat Z.ai (faqat Z.ai muhitida ishlaydi)
# SEARCH_ENGINE=open

# ======================================================================
# PREMIUM MANBALAR (ixtiyoriy) — kalit yozsangiz shu zahoti faollashadi.
# Kalit yo'q manbalar skanerni sekinlashtirmaydi, jimgina o'tkaziladi.
# Diagnostika tugmasida qaysi kalitlar faol ekanini ko'rasiz.
# ======================================================================

# Serper — Google qidiruv natijalari (eng aniq). https://serper.dev
# 2500 so'rov bepul. Kalitli dvigatel 403/429/captcha berMaydi.
# SERPER_API_KEY=

# Brave Search rasmiy API — https://api-dashboard.search.brave.com/register
# Oyiga 2000 so'rov bepul.
# BRAVE_API_KEY=

# Google Programmable Search — 2 ta qiymat kerak:
#   KEY: https://aistudio.google.com/app/apikey yoki Google Cloud API key
#   CX:  https://programmablesearchengine.google.com da yangi qidiruv dvigateli
#        yaratib ("Search the entire web" tanlab) olgan Search engine ID
# Kuniga 100 so'rov bepul.
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=

# Tavily AI qidiruv — https://app.tavily.com (oyiga 1000 bepul)
# TAVILY_API_KEY=

# Have I Been Pwned — email oqishlari (eng aniq baza, ~$3.50/oy)
# https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=

# Hunter.io — email tasdiqlash + domen bo'yicha xodimlar (oyiga 25 bepul)
# https://hunter.io/api-keys
# HUNTER_API_KEY=

# Shodan to'liq API — portlar/bannerlar/tarix (bepul hisob yetarli)
# https://account.shodan.io/register
# SHODAN_API_KEY=

# NumLookup — telefon raqam holati/operator (kuniga 100 bepul)
# https://app.numlookupapi.com/register
# NUMLOOKUP_API_KEY=

# IPinfo — aniq IP geo/ASN/VPN aniqlash (oyiga 50 000 bepul)
# https://ipinfo.io/signup
# IPINFO_TOKEN=

# Telegram Bot API — username skanerida ANIQ javob (chat id, turi, bio, obunachilar)
# Mutlaqo bepul: Telegram'da @BotFather oching → /newbot → tokenni shu yerga yozing
# TELEGRAM_BOT_TOKEN=
