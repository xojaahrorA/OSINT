generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bookmark {
  id        String   @id @default(cuid())
  title     String
  url       String
  snippet   String?
  module    String?
  moduleName String?
  query     String?
  createdAt DateTime @default(now())

  @@unique([url, query])
}

// TG Guruh/Kanal skaneri — skan ro'yxatidagi guruh/kanallar.
// Faqat OCHIQ guruhlar skanerlanadi (read-only: hech kimga yozilmaydi,
// hech qayerga qo'shilmaydi). Diniy kontentli guruhlar `religious=true`
// bilan belgilanadi va skan HECH QACHON o'tkazilmaydi.
model TelegramGroup {
  id         String    @id @default(cuid())
  username   String    @unique // @belgisiz, kichik harflarda
  title      String
  kind       String    @default("group") // channel | group
  members    Int       @default(0)
  tgId       String?   // Telegram chat id (string ko'rinishda)
  accessHash String?   // peer access hash — qidiruvda Resolve yo'q, to'g'ridan-to'g'ri ishlatiladi
  source     String    @default("user") // preset | user
  religious  Boolean   @default(false)
  lastStatus String?   // ok | flood | error | skipped
  lastScanAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([religious])
  @@index([source])
}

// API kalitlari — foydalanuvchi sozlamalar sahifasidan kiritadi.
// SQLite bazada saqlanadi: platforma qayta ishga tushsa ham (.env tozalansa ham)
// kalitlar YO'QOLMAYDI. Skaner/diagnostika ishga tushganda loadDbKeys() ularni
// process.env'ga birlashtiradi — premium manbalar avtomatik faollashadi.
model ApiKey {
  id        String   @id @default(cuid())
  envKey    String   @unique // masalan TELEGRAM_BOT_TOKEN, SERPER_API_KEY
  value     String   // kalitning o'zi
  label     String?  // ko'rsatma uchun (masalan "Telegram bot tokeni")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Skaner sessiyasi tarixi — har bir qidirilgan shaxs/maqsad bitta yozuvda
// to'liq saqlanadi. Sahifa yangilansa ham natijalar yo'qolmaydi: oxirgi
// sessiya avtomatik tiklanadi, eski sessiyalar "Tarix" panelida turadi.
model ScanSession {
  id           String   @id @default(cuid())
  rootQuery    String   // asosiy maqsad (batch rejimda birinchi so'rov)
  rootType     String   // username | email | phone | name | domain | ip
  queriesJson  String?  // batch so'rovlar ro'yxati (JSON massiv)
  status       String   @default("done") // done | stopped
  totalResults Int      @default(0)
  scansDone    Int      @default(0)
  // To'liq holat nusxasi (JSON): modules, results, intel, verdicts, skipped
  snapshotJson String?
  aiText       String?  // AI xulosa matni
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([rootQuery, rootType])
  @@index([updatedAt])
}
